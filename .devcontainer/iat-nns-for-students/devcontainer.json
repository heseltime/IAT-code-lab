{
  // For GitHub Codespaces, which only finds dev containers at the repository root.
  // Same environment as IAT-nns-for-students/.devcontainer (used when you open that folder in VS Code).
  "name": "IAT neural networks",
  "build": {
    "dockerfile": "../../IAT-nns-for-students/.devcontainer/Dockerfile",
    "context": "../../IAT-nns-for-students"
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/IAT-nns-for-students",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "iat_demo.ipynb"]
    }
  },
  "hostRequirements": {
    "memory": "4gb"
  }
}
